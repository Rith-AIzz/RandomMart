generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SUPPORT
  MANAGER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  TEST_CARD
  STRIPE
}

model Profile {
  id          String    @id @db.Uuid
  email       String    @unique @db.VarChar(254)
  fullName    String    @map("full_name") @db.VarChar(120)
  phone       String?   @db.VarChar(30)
  role        UserRole  @default(CUSTOMER)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  addresses   Address[]
  carts       Cart[]
  orders      Order[]
  auditLogs   AuditLog[]
  savedReports SavedReport[]
  notifications Notification[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  @@map("profiles")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  label       String   @db.VarChar(50)
  recipient   String   @db.VarChar(120)
  line1       String   @db.VarChar(180)
  line2       String?  @db.VarChar(180)
  city        String   @db.VarChar(100)
  region      String?  @db.VarChar(100)
  postalCode  String?  @map("postal_code") @db.VarChar(30)
  country     String   @db.VarChar(100)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
  @@map("addresses")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(80)
  slug        String    @unique @db.VarChar(90)
  description String?   @db.VarChar(500)
  imagePath   String?   @map("image_path") @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]
  @@index([isActive])
  @@map("categories")
}

model Product {
  id               String         @id @default(uuid()) @db.Uuid
  categoryId       String         @map("category_id") @db.Uuid
  name             String         @db.VarChar(140)
  slug             String         @unique @db.VarChar(160)
  shortDescription String         @map("short_description") @db.VarChar(240)
  description      String         @db.Text
  priceCents       Int            @map("price_cents")
  costCents        Int            @default(0) @map("cost_cents")
  discountCents    Int?           @map("discount_cents")
  sku              String         @unique @db.VarChar(60)
  stockQuantity    Int            @default(0) @map("stock_quantity")
  isActive         Boolean        @default(true) @map("is_active")
  isFeatured       Boolean        @default(false) @map("is_featured")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  wishlistItems    WishlistItem[]
  reviews          Review[]
  variants         ProductVariant[]
  inventoryMovements InventoryMovement[]
  @@index([categoryId])
  @@index([isActive, createdAt])
  @@map("products")
}

model WishlistItem {
  profileId String   @map("profile_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([profileId, productId])
  @@index([profileId, createdAt])
  @@map("wishlist_items")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  rating     Int
  title      String?  @db.VarChar(120)
  body       String   @db.VarChar(2000)
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([profileId, productId])
  @@index([productId, isApproved, createdAt])
  @@map("reviews")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  name          String   @db.VarChar(120)
  sku           String   @unique @db.VarChar(60)
  attributes    Json
  priceCents    Int?     @map("price_cents")
  stockQuantity Int      @default(0) @map("stock_quantity")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, isActive])
  @@map("product_variants")
}

model InventoryMovement {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  quantityDelta Int      @map("quantity_delta")
  reason        String   @db.VarChar(80)
  reference     String?  @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  path      String   @db.VarChar(500)
  altText   String   @map("alt_text") @db.VarChar(180)
  mimeType  String   @map("mime_type") @db.VarChar(80)
  sizeBytes Int      @map("size_bytes")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, sortOrder])
  @@map("product_images")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  profileId String     @map("profile_id") @db.Uuid
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items     CartItem[]
  @@index([profileId, isActive])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                    String        @id @default(uuid()) @db.Uuid
  profileId             String?       @map("profile_id") @db.Uuid
  guestEmail            String?       @map("guest_email") @db.VarChar(254)
  guestAccessToken      String?       @unique @map("guest_access_token") @db.VarChar(100)
  orderNumber           String        @unique @map("order_number") @db.VarChar(40)
  idempotencyKey        String        @unique @map("idempotency_key") @db.VarChar(100)
  stripeSessionId       String?       @unique @map("stripe_session_id") @db.VarChar(120)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id") @db.VarChar(120)
  status                OrderStatus   @default(PENDING)
  subtotalCents         Int           @map("subtotal_cents")
  discountCents         Int           @map("discount_cents")
  shippingCents         Int           @map("shipping_cents")
  taxCents              Int           @default(0) @map("tax_cents")
  refundedCents         Int           @default(0) @map("refunded_cents")
  totalCents            Int           @map("total_cents")
  cancellationReason    String?       @map("cancellation_reason") @db.VarChar(500)
  cancelledAt           DateTime?     @map("cancelled_at")
  shippingName          String        @map("shipping_name") @db.VarChar(120)
  shippingAddress       Json          @map("shipping_address")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  profile               Profile?      @relation(fields: [profileId], references: [id], onDelete: Restrict)
  items                 OrderItem[]
  payments              PaymentRecord[]
  @@index([profileId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  productName     String   @map("product_name") @db.VarChar(140)
  productSku      String   @map("product_sku") @db.VarChar(60)
  productImage    String?  @map("product_image") @db.VarChar(500)
  unitPriceCents  Int      @map("unit_price_cents")
  unitCostCents   Int      @default(0) @map("unit_cost_cents")
  quantity        Int
  lineTotalCents  Int      @map("line_total_cents")
  lineCostCents   Int      @default(0) @map("line_cost_cents")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
  @@map("order_items")
}

model PaymentRecord {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  method                PaymentMethod
  status                PaymentStatus
  amountCents           Int           @map("amount_cents")
  testReference         String?       @map("test_reference") @db.VarChar(100)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id") @db.VarChar(120)
  createdAt             DateTime      @default(now()) @map("created_at")
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
  @@map("payment_records")
}

model StripeEvent {
  id            String   @id @default(uuid()) @db.Uuid
  stripeEventId String   @unique @map("stripe_event_id") @db.VarChar(120)
  eventType     String   @map("event_type") @db.VarChar(100)
  processedAt   DateTime @default(now()) @map("processed_at")
  status        String   @default("PROCESSED") @db.VarChar(30)
  error         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  @@index([stripeEventId])
  @@map("stripe_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SavedReport {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  name      String   @db.VarChar(80)
  filters   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([profileId, name])
  @@index([profileId, updatedAt])
  @@map("saved_reports")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @map("profile_id") @db.Uuid
  kind      String    @db.VarChar(50)
  title     String    @db.VarChar(140)
  message   String    @db.VarChar(500)
  href      String?   @db.VarChar(500)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, readAt, createdAt])
  @@map("notifications")
}
